#!/bin/sh
# PROVIDE: gonf_endpoint_runtime
# REQUIRE: wireguard gonf_endpoint_rollback
# BEFORE: LOGIN
# KEYWORD: nojail
. /etc/rc.subr
name=gonf_endpoint_runtime
start_cmd=endpoint_start
stop_cmd=:
endpoint_start()
{
    if [ -f /var/db/gonf-endpoint/pending/record.json ]; then
        /usr/local/bin/python3.12 /usr/local/sbin/gonf-endpoint-rollback restore-after-boot /var/db/gonf-endpoint/pending || return 1
    fi
}
load_rc_config "$name"
run_rc_command "$1"
