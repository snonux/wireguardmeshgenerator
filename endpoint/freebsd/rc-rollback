#!/bin/sh
# PROVIDE: gonf_endpoint_rollback
# REQUIRE: FILESYSTEMS
# BEFORE: netif wireguard
# KEYWORD: nojail
. /etc/rc.subr
name=gonf_endpoint_rollback
start_cmd=endpoint_start
stop_cmd=:
endpoint_start()
{
    if [ -f /var/db/gonf-endpoint/pending/record.json ]; then
        /usr/local/sbin/gonf-endpoint-rollback restore-boot /var/db/gonf-endpoint/pending || return 1
    fi
}
load_rc_config "$name"
run_rc_command "$1"
